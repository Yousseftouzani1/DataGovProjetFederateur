# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=DataGovDB
DATABASE_NAME=DataGovDB
API_HOST=127.0.0.1
API_PORT=8001

# HDP Sandbox Configuration
# Set the IP of your VMware HDP Sandbox
ATLAS_URL=http://192.168.110.134:21000
ATLAS_USER=admin
ATLAS_PASSWORD=YOUR_ATLAS_PASSWORD

RANGER_URL=http://192.168.110.134:6080
RANGER_USER=admin
RANGER_PASSWORD=YOUR_RANGER_PASSWORD

# HDP Ambari
AMBARI_URL=http://192.168.110.134:8080

# Governance Mode - set to false for real Atlas/Ranger integration
MOCK_GOVERNANCE=false

# Authentication Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=YOUR_GENERATED_SECRET_KEY_HERE

# CORS Security
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
